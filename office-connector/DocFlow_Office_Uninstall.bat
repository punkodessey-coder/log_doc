@echo off
setlocal
chcp 65001 >nul
title DocFlow Office Connector - Uninstaller
echo.
echo ==========================================
echo   Удаление DocFlow Office Connector
echo ==========================================
echo.
echo Закройте Word, Excel и Visio перед продолжением.
echo Будут удалены регистрации надстроек и COM-классов DocFlow.
echo Документы и данные на сервере DocFlow не затрагиваются.
echo.
powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
set "RC=%ERRORLEVEL%"
if not "%RC%"=="0" (
  echo.
  echo Удаление не выполнено. Код ошибки: %RC%
  echo Проверьте, что все приложения Office закрыты, и запустите BAT повторно.
) else (
  echo.
  echo Готово. Перезапустите Office.
)
echo.
pause
exit /b %RC%
