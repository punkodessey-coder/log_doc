@echo off
setlocal EnableExtensions
chcp 65001 >nul
title DocFlow Office Connector - Offline Installer
echo.
echo ==========================================
echo   DocFlow Office Connector
echo   Standalone local installation
echo ==========================================
echo.
echo This installer contains the connector files.
echo It does NOT connect to GitHub or the Internet.
echo.
set "DF_SELF=%~f0"
set "DF_PS=%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe"
if not exist "%DF_PS%" (
  echo ERROR: Windows PowerShell was not found.
  pause
  exit /b 2
)
"%DF_PS%" -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; try { $raw=[IO.File]::ReadAllText($env:DF_SELF); $marker='###DOCFLOW_PAYLOAD_BASE64###'; $pos=$raw.IndexOf($marker); if($pos -lt 0){throw 'Embedded installation payload is missing.'}; $b64=($raw.Substring($pos+$marker.Length) -replace '\s',''); $bytes=[Convert]::FromBase64String($b64); if($bytes.Length -lt 10000){throw 'Embedded installation payload is incomplete.'}; $root=Join-Path $env:TEMP ('DocFlow-OfficeConnector-'+[guid]::NewGuid().ToString('N')); New-Item -ItemType Directory -Force -Path $root | Out-Null; $zip=Join-Path $root 'payload.zip'; [IO.File]::WriteAllBytes($zip,$bytes); $dest=Join-Path $root 'package'; Expand-Archive -LiteralPath $zip -DestinationPath $dest -Force; $script=Join-Path $dest 'scripts\install.ps1'; $dll=Join-Path $dest 'bin\DocFlow.OfficeConnector.dll'; if(!(Test-Path -LiteralPath $script)){throw 'Installer script is missing from embedded package.'}; if(!(Test-Path -LiteralPath $dll)){throw 'Office connector DLL is missing from embedded package.'}; & $DF_PS -NoLogo -NoProfile -ExecutionPolicy Bypass -File $script -DllPath $dll -OfficeBitness Auto; if($LASTEXITCODE -ne 0){throw ('Installation script failed with exit code '+$LASTEXITCODE)}; Write-Host ''; Write-Host 'Installation completed. Restart Word, Excel and Visio.' -ForegroundColor Green; exit 0 } catch { Write-Host ''; Write-Host ('INSTALLATION FAILED: '+$_.Exception.Message) -ForegroundColor Red; exit 1 }"
set "RC=%ERRORLEVEL%"
echo.
if not "%RC%"=="0" (
  echo Installation failed. Exit code: %RC%
) else (
  echo Installation completed successfully.
)
echo.
pause
exit /b %RC%
